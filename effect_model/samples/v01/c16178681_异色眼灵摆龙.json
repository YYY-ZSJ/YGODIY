{
  "schema": "ygodiy-effect/0.1",
  "card": {"code": 16178681, "name": "异色眼灵摆龙", "kind": "monster", "subtypes": ["effect", "pendulum"]},
  "summon": {"method": "pendulum"},
  "effects": [
    {"box": "pendulum", "type": "continuous", "limit": {"scope": "name"},
     "apply": {"what": "avoid_battle_damage",
