       {"act": "add_to_hand", "link": "then",
        "what": {"who": "you", "where": ["deck"], "count": 1,
                 "filter": [{"card_type": "monster"}, {"subtype": "pendulum"}, {"atk": ["<=", 1500]}]}}
     ]},
    {"type": "continuous",
     "apply": {"what": "double_battle_damage", "when": "battling_opp_monster"}}
  ]
